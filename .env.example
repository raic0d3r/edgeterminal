# DEMO is the safe default. Set to live only after confirming provider entitlements.
MARKET_DATA_MODE=demo
MARKET_DATA_PROVIDER=twelvedata
TWELVE_DATA_API_KEY=

# Trading Economics API credentials; configure only if your subscription includes API use.
ECONOMIC_DATA_MODE=demo
TRADING_ECONOMICS_API_KEY=
TRADING_ECONOMICS_API_SECRET=

# Monthly subscription billing (Stripe integration stage)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=

# Supabase (authentication/database integration stage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
\n# Firebase Web App config (copy to .env.local and fill in values)\nNEXT_PUBLIC_FIREBASE_API_KEY=\nNEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=\nNEXT_PUBLIC_FIREBASE_PROJECT_ID=\nNEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=\nNEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=\nNEXT_PUBLIC_FIREBASE_APP_ID=\n
# Server-only Firebase Admin credentials (never prefix these with NEXT_PUBLIC_).
# Paste the service account JSON as one line, escaping quotes as needed.
FIREBASE_SERVICE_ACCOUNT_KEY=
# Comma-separated emails allowed to use the Admin User Management API.
ADMIN_EMAILS=you@example.com

# Optional global subscription checkout links (HTTPS only). Per-feature links can be set in Admin > Feature Access & Pricing.
NEXT_PUBLIC_PRO_SUBSCRIPTION_URL=
NEXT_PUBLIC_VIP_SUBSCRIPTION_URL=
PRO_SUBSCRIPTION_URL=
VIP_SUBSCRIPTION_URL=
